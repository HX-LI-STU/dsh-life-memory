{
  "name": "dsh-life-memory",
  "version": "1.1.5",
  "description": "Long-term, low-context memory for DeepSeek Harness (DSH): never-deleted raw conversations, vector/FTS retrieval, layered memory, shared and per-persona vaults. 长期、低上下文依赖的记忆插件：永不删除的原始会话、向量检索、分层记忆、共享与人格独立记忆库。",
  "author": "hanxustu",
  "contributors": [
    "hanxustu"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-memory",
    "long-term-memory",
    "conversation-memory",
    "layered-memory",
    "sqlite",
    "vector-search",
    "immutable-archive",
    "persona"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "copyright": "Copyright (c) 2026 hanxustu (dsh-life-memory)"
}
